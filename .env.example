# Valorant Creator Studio - modelo de configuracao
#
# Copie para ".env" (que e ignorado pelo Git) e ajuste.
# Este arquivo contem APENAS nomes de variaveis e valores ilustrativos, nunca segredos reais.
# Todas sao opcionais. Veja docs/USAGE.md para o passo a passo.

# --- Servidor local (nao exponha para a internet) ---
VCS_HOST=127.0.0.1
VCS_PORT=8000

# --- Modo desenvolvimento (opcional) ---
# VCS_DEV=1 confia na origem do servidor de desenvolvimento da interface (http://localhost:5173) e liga a
# documentacao interativa da API em /api/docs. VCS_API_DOCS=1 liga so a documentacao (ela carrega scripts de uma CDN).
VCS_DEV=
VCS_API_DOCS=

# --- Pastas locais ---
# Pasta de trabalho (banco SQLite, temporarios, miniaturas) e pasta de saida dos cortes exportados.
VCS_DATA_DIR=./data
VCS_OUTPUT_DIR=./data/output

# --- FFmpeg (opcional; se vazio, usa o que estiver no PATH) ---
VCS_FFMPEG_PATH=
VCS_FFPROBE_PATH=

# --- Twitch (OAuth) - opcional, so para importar VODs pelo link ---
# Crie um aplicativo em https://dev.twitch.tv/console e preencha localmente.
TWITCH_CLIENT_ID=seu_client_id_aqui
TWITCH_CLIENT_SECRET=seu_client_secret_aqui

# --- YouTube Data API - opcional, so para o radar de tendencias ---
YOUTUBE_API_KEY=sua_api_key_aqui
